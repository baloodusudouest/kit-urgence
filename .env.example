# Variables de la stack (Portainer > Stacks > Environment variables, ou fichier .env)
# Ne jamais versionner les vraies valeurs.

# Dossier des sources et du kit généré (éditable depuis le réseau local)
KIT_DATA_DIR=/volume1/homes/<utilisateur>/kit-urgence
# Clé SSH, empreintes, statut : hors de tout partage réseau
KIT_STATE_DIR=/volume1/docker/kit-urgence/state

# Mot de passe du livre 05 – Papiers (le même que sur la fiche papier)
KIT_PAPIERS_PASSWORD=change-moi

# Jeton partagé avec Home Assistant (secrets.yaml : kit_urgence_token)
# Générer par exemple avec : python -c "import secrets;print(secrets.token_urlsafe(32))"
KIT_API_TOKEN=change-moi
