# Variables de la stack (Portainer > Stacks > Environment variables, ou fichier .env)
# Ne jamais versionner les vraies valeurs.

# Dossier des sources et du kit généré (éditable depuis le réseau local)
KIT_DATA_DIR=/volume1/homes/<utilisateur>/kit-urgence
# Clé SSH, empreintes, statut : hors de tout partage réseau
KIT_STATE_DIR=/volume1/docker/kit-urgence/state

# Mot de passe du livre 05 – Papiers (le même que sur la fiche papier)
KIT_PAPIERS_PASSWORD=change-moi

# Jeton partagé avec Home Assistant (secrets.yaml : kit_urgence_token)
# Générer par exemple avec : python -c "import secrets;print(secrets.token_urlsafe(32))"
KIT_API_TOKEN=change-moi

# --- variables communes de la maison (depuis la 2.5.0, plus aucun ancien nom n'est lu) ---
# Mot de passe commun des applis (le même pour toutes, 12 caractères au moins)
MAISON_PASSWORD=change-moi
# Jeton commun des échanges entre applis maison : accepté en plus de KIT_API_TOKEN (pour carnet),
# et seul à ouvrir la sauvegarde des réglages pour l'Anneau. KIT_API_TOKEN reste obligatoire (Home Assistant).
# MAISON_JETON=un-long-jeton-commun
# « oui » : aucune appli de la maison n'écrit ; KIT_LECTURE_SEULE, si elle est posée, l'emporte pour le kit
# MAISON_LECTURE_SEULE=oui

# 1 (ou oui) pour le premier jour d'une nouvelle version : le kit n'écrit ni sur la liseuse ni dans ses sources
# (ses réglages se changent quand même) ; « non » : le kit écrit même si MAISON_LECTURE_SEULE=oui
KIT_LECTURE_SEULE=

# Réglages d'usage (nom du foyer, liseuse, intervalle) : dans l'écran Réglages du kit, pas dans la stack.
# Le lien « Ouvrir dans carnet » prend l'adresse de la tuile « carnet » de l'Anneau.
